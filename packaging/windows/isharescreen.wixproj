<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>iShareScreen</OutputName>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\dist\</OutputPath>
    <InstallerPlatform>x64</InstallerPlatform>
    <DebugType>none</DebugType>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\dist</PublishDir>
    <LicenseRtf Condition="'$(LicenseRtf)' == ''">$(MSBuildThisFileDirectory)..\..\build\msi\AGPL-3.0.rtf</LicenseRtf>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion);LicenseRtf=$(LicenseRtf)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
